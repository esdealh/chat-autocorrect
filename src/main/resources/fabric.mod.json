{
  "schemaVersion": 1,
  "id": "chat-autocorrect",
  "version": "${version}",
  "name": "Chat Autocorrect",
  "description": "Fixes your chat messages before they're sent: capitalization, punctuation, contractions and spelling. Client-side and lightweight.",
  "authors": [
    "esdealh"
  ],
  "contact": {
    "sources": "https://github.com/esdealh/chat-autocorrect",
    "issues": "https://github.com/esdealh/chat-autocorrect/issues"
  },
  "license": "MIT",
  "icon": "assets/chat-autocorrect/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.rina.chatautocorrect.ChatAutocorrectClient"
    ],
    "modmenu": [
      "com.rina.chatautocorrect.ModMenuIntegration"
    ]
  },
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "${mc_range}",
    "java": ">=21",
    "fabric-api": "*"
  },
  "suggests": {
    "modmenu": "*"
  }
}
